#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB=""
PKG_DEV="bash git curl xz zstd libarchive-tools util-linux losetup e2fsprogs"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing bootstrap"
#config
TARGET_OUTPUT=/output
mkdir -p ${TARGET_OUTPUT}
TARGET_ARCH=$(uname -m)
ARCH_MIRROR=
if [ "${TARGET_ARCH}" = "x86_64" ]; then
	ARCH_MIRROR=https://http.krfoss.org/archlinux
elif [ "${TARGET_ARCH}" = "aarch64" ]; then
	ARCH_MIRROR=https://http.krfoss.org/archlinuxarm
fi

#basic
mkdir -p ${TARGET_OUTPUT}/dev
touch "${TARGET_OUTPUT}/dev/null"
touch "${TARGET_OUTPUT}/dev/random"
touch "${TARGET_OUTPUT}/dev/urandom"
/usr/local/bin/arch-bootstrap.sh -a ${TARGET_ARCH} ${TARGET_OUTPUT}

#mirror
echo "Server = ${ARCH_MIRROR}/\$repo/os/\$arch" > ${TARGET_OUTPUT}/etc/pacman.d/mirrorlist

#resolve
cat <<- EOF > ${TARGET_OUTPUT}/etc/resolv.conf
nameserver 1.1.1.1
nameserver 1.0.0.1
EOF


#archlinux fix
if [ -e "${TARGET_OUTPUT}/etc/arch-release" ]; then
	if [ -e ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz ]; then
		rm -rf ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8
		gzip -dk ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz
	fi

	if [ ! -z "$(find ${TARGET_OUTPUT}/usr/share/terminfo/ 2> /dev/null | grep '_ADMIN_')" ]; then
		for t in ${TARGET_OUTPUT}/usr/share/terminfo/*_ADMIN_*
		do
			mv ${t} ${t/_ADMIN_*/}
		done
	fi
fi

#pacman
sed -i -e "s/\(Architecture =\) auto/\1 ${TARGET_ARCH}/g" ${TARGET_OUTPUT}/etc/pacman.conf
sed -i -e "s/^#\(NoUpgrade   =\)/\1 \/etc\/pacman.d\/mirrorlist/g" ${TARGET_OUTPUT}/etc/pacman.conf
sed -i -e 's/^#Color/Color/g' -e 's/^#DisableSandbox/DisableSandbox/g' ${TARGET_OUTPUT}/etc/pacman.conf
sed -i -e '/^#\[multilib\]$/,/^#Include = \/etc\/pacman.d\/mirrorlist$/s/^#//' ${TARGET_OUTPUT}/etc/pacman.conf

#yay
mkdir -p /build/yay
cd /build/yay
YAY_VERSION="$(wget --no-check-certificate -q -O - https://github.com/Jguer/yay/releases | grep "/Jguer/yay/tree/.*" | head -1 | sed -e 's@^.*"/Jguer/yay/tree/v\([^"]*\)".*$@\1@g')"
YAY_ADDR="https://github.com/Jguer/yay/releases/download/v${YAY_VERSION}/yay_${YAY_VERSION}_${TARGET_ARCH}.tar.gz"
wget --no-check-certificate -q -O - ${YAY_ADDR} | tar zx
cd yay_*
mv yay ${TARGET_OUTPUT}/usr/local/bin/
cd /
rm -rf /build

#clear
rm -rf ${TARGET_OUTPUT}/.BUILDINFO ${TARGET_OUTPUT}/.INSTALL ${TARGET_OUTPUT}/.MTREE ${TARGET_OUTPUT}/.PKGINFO

#script
rm -rf ${TARGET_OUTPUT}/usr/local/bin/docker-*
cp /usr/local/bin/docker-install.arch ${TARGET_OUTPUT}/usr/local/bin/docker-install
cp /usr/local/bin/docker-adduser ${TARGET_OUTPUT}/usr/local/bin/
cp /usr/local/bin/docker-chown ${TARGET_OUTPUT}/usr/local/bin/
cp /usr/local/bin/docker-run ${TARGET_OUTPUT}/usr/local/bin/

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

