#!/bin/sh

set -e

set +e
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing stage2"
TARGET_LOCALE=${TARGET_LOCALE:-ko_KR.UTF-8}
TIMEZONE=${TIMEZONE:-Asia/Seoul}
TARGET_ARCH=$(uname -m)
PACMAN_BASE_PKGS="bash coreutils diffutils filesystem findutils gettext grep gzip less pacman procps-ng sed systemd sudo haveged gawk archlinux-keyring"
PACMAN_REMOVE_PKGS="procps-ng haveged"
pacman -Suy --noconfirm --overwrite "*" ${PACMAN_BASE_PKGS} ${PACMAN_REMOVE_PKGS} || true
find /etc -name \*.pacnew -exec rm -rf {} \;

#cachyos
if [ "${TARGET_ARCH}" = "x86_64" ]; then
	pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
	pacman-key --lsign-key F3B607488DB35A47
	pacman --noconfirm -U 'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-keyring-20240331-1-any.pkg.tar.zst' \
	'https://mirror.cachyos.org/repo/x86_64/cachyos/cachyos-mirrorlist-27-1-any.pkg.tar.zst' \
	'https://mirror.cachyos.org/repo/x86_64/cachyos/pacman-7.1.0.r9.g54d9411-4-x86_64.pkg.tar.zst'
	sed -i '/^\[core\]$/i [cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n' /etc/pacman.conf
	pacman -Suy --noconfirm

	if [ -e /etc/pacman.conf.pacnew ]; then
		mv /etc/pacman.conf.pacnew /etc/pacman.conf
		sed -i -e "s/\(Architecture =\) auto/\1 ${TARGET_ARCH}/g" /etc/pacman.conf
		sed -i -e "s/^#\(NoUpgrade   =\)/\1 \/etc\/pacman.d\/mirrorlist/g" /etc/pacman.conf
		sed -i -e 's/^#Color/Color/g' -e 's/^#DisableSandbox/DisableSandbox/g' /etc/pacman.conf
		sed -i -e '/^#\[multilib\]$/,/^#Include = \/etc\/pacman.d\/mirrorlist$/s/^#//' /etc/pacman.conf
		sed -i '/^\[core\]$/i [cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n' /etc/pacman.conf
	fi
fi

#password
passwd -d root

#users gid
sed -i -e "s/^users:x:.*$/users:x:100:/g" /etc/group

##resolve
#cat <<- EOF > /etc/resolv.conf
#nameserver 1.1.1.1
#nameserver 1.0.0.1
#EOF

#systemd-sysusers
if [ -e "/usr/bin/systemd-sysusers" ]; then
	/usr/bin/systemd-sysusers
fi

#update-ca-trust
update-ca-trust

#keyring
/usr/bin/haveged ; /usr/bin/rm -fr /etc/pacman.d/gnupg ; /usr/bin/pacman-key --init ; /usr/bin/pacman-key --populate ${ARCH_KEYRING}

#basic config
sed -i -e "s/#*[ ]*${TARGET_LOCALE}/${TARGET_LOCALE}/g" /etc/locale.gen
sed -i -e "s/#*[ ]*en_US.UTF-8/en_US.UTF-8/g" /etc/locale.gen
echo "LANG=${TARGET_LOCALE}" >> /etc/locale.conf
echo "LC_ALL=${TARGET_LOCALE}" >> /etc/locale.conf
locale-gen

#timezone
if [ -e "/usr/share/zoneinfo/${TIMEZONE}" ]; then
	rm -rf /etc/localtime
	ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
fi

#skel
cp -ar /etc/skel/. /root/

#makepkg
[ -e /usr/bin/makepkg ] && sed -i -e 's/(( EUID == 0 ))/false /g' /usr/bin/makepkg

pacman -Rsn --noconfirm ${PACMAN_REMOVE_PKGS} || true
#echo -e "Y\nY" | pacman -Scc &> /dev/null
docker-install -d -c
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo
set -e

exit 0

