#!/bin/sh

set -e

fn_stage1() {
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
	PKG_LIB=""
	PKG_DEV="bash git curl xz zstd libarchive-tools util-linux e2fsprogs"
	docker-install -r -u ${PKG_LIB} ${PKG_DEV}
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	echo

	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Downloading bootstrap"
	mkdir -p /build
	cd /build
	git clone https://forumi0721@bitbucket.org/forumi0721/docker-dist-extras.git extras --depth=1
	cd /
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	echo

	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing bootstrap"
	TARGET_OUTPUT=/build/archroot
	TARGET_QEMU=
	mkdir -p ${TARGET_OUTPUT}
	cd /build
	ARCH_ARCH=${TARGET_ARCH}
	ARCH_ARCH=${ARCH_ARCH/x64/x86_64}
	ARCH_ARCH=${ARCH_ARCH/armhf/armv7h}
	ARCH_ARCH=${ARCH_ARCH/aarch64/aarch64}
	ARCH_MIRROR=
	if [ "${ARCH_ARCH}" = "x86_64" ]; then
		TARGET_ARCH="x64"
		#ARCH_MIRROR=http://ftp.lanet.kr/pub/archlinux
		#ARCH_MIRROR=http://ftp.harukasan.org/archlinux
		ARCH_MIRROR=http://mirror.anigil.com/archlinux
	elif [ "${ARCH_ARCH}" = "aarch64" ]; then
		if [ -e /usr/local/bin/qemu-aarch64-static ]; then
			cp /usr/local/bin/qemu-aarch64-static /build/extras/qemu-aarch64-static
		fi
		TARGET_ARCH="aarch64"
		TARGET_QEMU=qemu-aarch64-static
		#ARCH_MIRROR=http://ca.us.mirror.archlinuxarm.org
		ARCH_MIRROR=http://tw.mirror.archlinuxarm.org
	elif [ "${ARCH_ARCH}" = "armv7h" ]; then
		if [ -e /usr/local/bin/qemu-arm-static ]; then
			cp /usr/local/bin/qemu-arm-static /build/extras/qemu-arm-static
		fi
		TARGET_ARCH="armhf"
		TARGET_QEMU=qemu-arm-static
		#ARCH_MIRROR="http://ca.us.mirror.archlinuxarm.org"
		ARCH_MIRROR="http://tw.mirror.archlinuxarm.org"
	fi

	/build/extras/arch-bootstrap.sh -a ${ARCH_ARCH} -r "${ARCH_MIRROR}" /build/archroot
	rm -rf ${TARGET_OUTPUT}/.BUILDINFO ${TARGET_OUTPUT}/.INSTALL ${TARGET_OUTPUT}/.MTREE ${TARGET_OUTPUT}/.PKGINFO
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	echo

	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
	#resolve
	cat <<- EOF > ${TARGET_OUTPUT}/etc/resolv.conf
	nameserver 1.1.1.1
	nameserver 1.0.0.1
	EOF

	#clear
	rm -rf ${TARGET_OUTPUT}/usr/local/bin/docker-*

	#qemu
	if [ ! -z "${TARGET_QEMU}" ]; then
		cp -f extras/${TARGET_QEMU} "${TARGET_OUTPUT}/usr/bin/"
		cp -f extras/${TARGET_QEMU} "${TARGET_OUTPUT}/usr/local/bin/"
		chmod 4755 "${TARGET_OUTPUT}/usr/local/bin/${TARGET_QEMU}"
		cat << EOF > ${TARGET_OUTPUT}/usr/local/bin/sudo
#!/bin/sh

qemu=/usr/local/bin/${TARGET_QEMU}
sudo=/usr/bin/sudo

if grep -q -w lm /proc/cpuinfo ; then
		if [ "\$(basename "\${0}")" = "sudoedit" ]; then
				\${qemu} -execve -0 /bin/sh \${sudo} -e "\${@}"
		else
				\${qemu} -execve -0 /bin/sh \${sudo} "\${@}"
		fi
else
		if [ "\$(basename "\${0}")" = "sudoedit" ]; then
				\${sudo} -e "\${@}"
		else
				\${sudo} "\${@}"
		fi
fi

exit \$?
EOF
		chmod 4755 ${TARGET_OUTPUT}/usr/local/bin/sudo
		ln -s sudo ${TARGET_OUTPUT}/usr/local/bin/sudoedit
	fi

	#docker-run
	cp extras/docker-run ${TARGET_OUTPUT}/usr/local/bin/docker-run

	#docker-install
	cp -f extras/docker-install.arch ${TARGET_OUTPUT}/usr/local/bin/docker-install
	rm -rf ${TARGET_OUTPUT}/usr/local/bin/docker-sysusers ${TARGET_OUTPUT}/usr/local/bin/docker-tmpfiles

	#docker-build
	if [ "${TARGET_ARCH}" = "armhf" ]; then
		cp -f extras/docker-build-arm "${TARGET_OUTPUT}/usr/local/bin/"
		ln -sf docker-build-arm "${TARGET_OUTPUT}/usr/local/bin/docker-build-start"
		ln -sf docker-build-arm "${TARGET_OUTPUT}/usr/local/bin/docker-build-end"
	elif [ "${TARGET_ARCH}" = "aarch64" ]; then
		cp -f extras/docker-build-aarch64 "${TARGET_OUTPUT}/usr/local/bin/"
		ln -sf docker-build-aarch64 "${TARGET_OUTPUT}/usr/local/bin/docker-build-start"
		ln -sf docker-build-aarch64 "${TARGET_OUTPUT}/usr/local/bin/docker-build-end"
	else
		cp -f extras/docker-build-x64 "${TARGET_OUTPUT}/usr/local/bin/docker-build-x64"
		ln -sf docker-build-x64 "${TARGET_OUTPUT}/usr/local/bin/docker-build-start"
		ln -sf docker-build-x64 "${TARGET_OUTPUT}/usr/local/bin/docker-build-end"
	fi

	#docker-adduser
	cp -f extras/docker-adduser ${TARGET_OUTPUT}/usr/local/bin/docker-adduser

	#docker-chown
	cp -f extras/docker-chown ${TARGET_OUTPUT}/usr/local/bin/docker-chown

	#archlinux fix
	if [ -e "${TARGET_OUTPUT}/etc/arch-release" ]; then
		if [ -e ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz ]; then
			rm -rf ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8
			gzip -dk ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz
		fi

		if [ ! -z "$(find ${TARGET_OUTPUT}/usr/share/terminfo/ 2> /dev/null | grep '_ADMIN_')" ]; then
			for t in ${TARGET_OUTPUT}/usr/share/terminfo/*_ADMIN_*
			do
				mv ${t} ${t/_ADMIN_*/}
			done
		fi
	fi

	#Workaound for Docker
	if [ "${TARGET_ARCH}" = "x64" ]; then
		local patched_glibc=glibc-linux4-2.33-4-x86_64.pkg.tar.zst
		wget --no-check-certificate -q -o ${TARGET_OUTPUT}/${patched_glibc} "https://repo.archlinuxcn.org/x86_64/${patched_glibc}"
		bsdtar -C ${TARGET_OUTPUT}/ -xf "${patched_glibc}"
		rm -rf "${TARGET_OUTPUT}/${patched_glibc}"
		rm -rf ${TARGET_OUTPUT}/.BUILDINFO ${TARGET_OUTPUT}/.INSTALL ${TARGET_OUTPUT}/.MTREE ${TARGET_OUTPUT}/.PKGINFO
	fi

	##yaourt (stage1)
	#if [ -e extras/package-query-*-${ARCH_ARCH}.pkg.tar.xz -a -e extras/yaourt-*-any.pkg.tar.xz ]; then
	#	cp extras/package-query-*-${ARCH_ARCH}.pkg.tar.xz ${TARGET_OUTPUT}/package-query.pkg.tar.xz
	#	cp extras/yaourt-*-any.pkg.tar.xz ${TARGET_OUTPUT}/yaourt.pkg.tar.xz
	#fi

	#yay
	mkdir -p /build/yay
	cd /build/yay
	YAY_ADDR="https://github.com$(wget --no-check-certificate -q -O - https://github.com/Jguer/yay/releases | grep "/Jguer/yay/releases/download/.*/yay_.*_${ARCH_ARCH}.tar.gz" | head -1 | sed -e 's/^.*<a href="\([^"]*\)".*$/\1/g')"
	wget --no-check-certificate -q -O - ${YAY_ADDR} | tar zx
	cd yay_*
	mv yay ${TARGET_OUTPUT}/usr/local/bin/

	cd /
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	echo

	#echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
	#docker-install -d -c ${PKG_DEV}
	#if [ "${TARGET_ARCH}" = "aarch64" ]; then
	#	rm -rf /usr/bin/qemu-aarch64-static
	#elif [ "${TARGET_ARCH}" = "armhf" ]; then
	#	rm -rf /usr/bin/qemu-arm-static
	#fi
	#echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	#echo
}


fn_stage2() {
	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing stage2"
	TARGET_OUTPUT=/
	TARGET_LOCALE=${TARGET_LOCALE:-ko_KR.UTF-8}
	TARGET_TIMEZONE=${TARGET_TIMEZONE:-Asia/Seoul}
	ARCH_ARCH=
	if [ -e /usr/bin/qemu-aarch64-static ]; then
		ARCH_ARCH=aarch64
	elif [ -e /usr/bin/qemu-arm-static ]; then
		ARCH_ARCH=armv7h
	else
		ARCH_ARCH=x86_64
	fi
	ARCH_ARCH=${ARCH_ARCH/armhf/armv7h}
	ARCH_ARCH=${ARCH_ARCH/aarch64/aarch64}
	#local PACMAN_BASE_PKGS="bash coreutils diffutils filesystem findutils gettext glibc grep gzip less pacman procps-ng sed systemd haveged"
	local PACMAN_BASE_PKGS="bash coreutils diffutils filesystem findutils gettext grep gzip less pacman procps-ng sed systemd haveged gawk"
	local PACMAN_REMOVE_PKGS="gzip less procps-ng haveged"
	pacman -Suy --noconfirm --overwrite "*" ${PACMAN_BASE_PKGS} ${PACMAN_REMOVE_PKGS}  || true
	find /etc -name \*.pacnew
	find /etc -name \*.pacnew -exec rm -rf {} \;

	passwd -d root

	if [ "$(uname -m)" = "x86_64" ]; then
		local patched_glibc=glibc-linux4-2.33-4-x86_64.pkg.tar.zst
		curl -o ${TARGET_OUTPUT}/${patched_glibc} "https://repo.archlinuxcn.org/x86_64/${patched_glibc}"
		bsdtar -C ${TARGET_OUTPUT}/ -xf "${patched_glibc}"
		rm -rf "${TARGET_OUTPUT}/${patched_glibc}"
		rm -rf ${TARGET_OUTPUT}/.BUILDINFO ${TARGET_OUTPUT}/.INSTALL ${TARGET_OUTPUT}/.MTREE ${TARGET_OUTPUT}/.PKGINFO
	fi

	#users gid
	sed -i -e "s/^users:x:.*$/users:x:100:/g" ${TARGET_OUTPUT}/etc/group

	#resolve
	cat <<- EOF > ${TARGET_OUTPUT}/etc/resolv.conf
	nameserver 1.1.1.1
	nameserver 1.0.0.1
	EOF

	#systemd-sysusers
	if [ -e "${TARGET_OUTPUT}/usr/bin/systemd-sysusers" ]; then
		/usr/bin/systemd-sysusers
	fi

	#update-ca-trust
	update-ca-trust

	#keyring
	set +e
	/usr/bin/haveged ; /usr/bin/rm -fr /etc/pacman.d/gnupg ; /usr/bin/pacman-key --init ; /usr/bin/pacman-key --populate ${ARCH_KEYRING}
	set -e

	#basic config
    #echo "${PACMAN_MIRRORLIST}" > ${TARGET_OUTPUT}/etc/pacman.d/mirrorlist
    sed -i -e "s/\(Architecture =\) auto/\1 ${ARCH_ARCH}/g" ${TARGET_OUTPUT}/etc/pacman.conf
    sed -i -e "s/#\(NoUpgrade   =\)/\1 \/etc\/pacman.d\/mirrorlist/g" ${TARGET_OUTPUT}/etc/pacman.conf

	#locale
	#if [ -e ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz ]; then
	#	rm -rf ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8
	#	gzip -dk ${TARGET_OUTPUT}/usr/share/i18n/charmaps/UTF-8.gz
	#fi
	sed -i -e "s/#*[ ]*${TARGET_LOCALE}/${TARGET_LOCALE}/g" ${TARGET_OUTPUT}/etc/locale.gen
	echo "LANG=${TARGET_LOCALE}" >> ${TARGET_OUTPUT}/etc/locale.conf
	echo "LC_ALL=${TARGET_LOCALE}" >> ${TARGET_OUTPUT}/etc/locale.conf
	locale-gen

	#timezone
	if [ -e "${TARGET_OUTPUT}/usr/share/zoneinfo/${TARGET_TIMEZONE}" ]; then
		rm -rf ${TARGET_OUTPUT}/etc/localtime
		ln -sf /usr/share/zoneinfo/${TARGET_TIMEZONE} ${TARGET_OUTPUT}/etc/localtime
	fi

	#skel
	cp -ar ${TARGET_OUTPUT}/etc/skel/. ${TARGET_OUTPUT}/root/

	##yaourt
	if [ -e /output ]; then
		if [ "$(uname -m)" = "x86_64" ]; then
			/usr/bin/pacman -Sy --noconfirm ; /usr/bin/pacman -U --noconfirm --asdeps /output/package-query-*.pkg.tar.zst; /usr/bin/pacman -U --noconfirm /output/yaourt-*.pkg.tar.zst
		else
			/usr/bin/pacman -Sy --noconfirm ; /usr/bin/pacman -U --noconfirm --asdeps /output/package-query-*.pkg.tar.xz; /usr/bin/pacman -U --noconfirm /output/yaourt-*.pkg.tar.xz
		fi
	fi
	rm -rf /output

	#makepkg
	[ -e /usr/bin/makepkg ] && sed -i -e 's/(( EUID == 0 ))/false /g' /usr/bin/makepkg

	docker-install -d -c

	cd /
    mkdir -p usr/local/bin
    echo "#!/bin/sh" > usr/local/bin/docker-init
    echo >> usr/local/bin/docker-init
    find . -not -path './dev/*' -not -path './proc/*' -not -path './sys/*' -exec stat -c "chmod %a \"%n\"" "{}" \; | grep -v '^chmod [0-9][0-9][0-9] ' | sed -e 's/^\(chmod [0-9]\+\) "\./\1 "/g' >> usr/local/bin/docker-init
    echo >> usr/local/bin/docker-init
    echo "passwd -d root" >> usr/local/bin/docker-init
    chmod 755 usr/local/bin/docker-init

	echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
	echo
}


if [ ! -e /etc/pacman.conf ]; then
	fn_stage1
else
	fn_stage2
fi

