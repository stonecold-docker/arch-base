#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB=""
PKG_DEV="base-devel git"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Building yaourt"

sed -i -e 's/(( EUID == 0 ))/false /g' /usr/bin/makepkg

passwd -d root
mkdir -p /output

rm -rf /build
mkdir -p /build

git clone https://aur.archlinux.org/package-query.git --depth 1
cd package-query
makepkg -si --noconfirm
if [ "$(uname -m)" = "x86_64" ]; then
	cp *.pkg.tar.zst /output/
else
	cp *.pkg.tar.xz /output/
fi
cd ..

git clone https://aur.archlinux.org/yaourt.git --depth 1
cd yaourt
makepkg -si --noconfirm
if [ "$(uname -m)" = "x86_64" ]; then
	cp *.pkg.tar.zst /output/
else
	cp *.pkg.tar.xz /output/
fi
cd ..

cd /
rm -rf /build

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

