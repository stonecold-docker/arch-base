ARG BASE_TAG=x64

FROM forumi0721/alpine-base:${BASE_TAG} as builder_stage1

LABEL maintainer="forumi0721@gmail.com"

ARG BUILD_TAG=aarch64

COPY local/bin/docker-build-stage1 /usr/local/bin/

RUN ["docker-build-stage1"]



